# Credentials. Nothing under here has ever been committed and nothing should be.
04-implementation/host/.lab-secrets/
*.key
*.pem
client.keys
authd.pass

# Raw evidence carries account names, source addresses, task contents and install detail. The
# two exceptions are the sanitised summaries written specifically to be committed.
04-implementation/evidence/*
!04-implementation/evidence/README.md
!04-implementation/evidence/validation-status.md
host-preflight.json

# Large artefacts that are fetched or built rather than stored. The manager package is half a
# gigabyte; tests/fetch-engine-package.sh retrieves it and checks it against a pinned hash.
.cache/
*.part
wazuh-install-files.tar
*.msi
*.deb
*.iso
*.vhd*

# Working files
**/__pycache__/
*.bak
*.log
Thumbs.db
desktop.ini

# Generated by the modelling step: datasets are rebuilt from a campaign, weights are
# retrained from the dataset, and neither is a source file.
05-detection-modelling/data/
05-detection-modelling/models/
*.pt

# The report page is an intermediate: build-report.py regenerates it from the
# measurement artefacts every time, and the PDF beside the proposal is the deliverable.
05-detection-modelling/report/report.html
